exports[`RTL rendering > approval cards: Hebrew parameters keep their direction 1`] = `"<article class="rz-panel relative overflow-hidden rz-held" aria-label="sheets_append: Held"><header class="flex items-start gap-3 px-4 pt-3.5 pb-3 ps-5"><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h3 class="m-0 text-[15px] font-semibold text-foreground">sheets_append</h3></div><div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-subtle-foreground"><span class="inline-flex items-center gap-1.5"><span class="rz-avatar rz-avatar--agent rz-avatar--sm" aria-hidden="true">SI</span>Agent: site-payments</span><span>Venture: tower-b</span></div></div><span class="rz-badge rz-badge--accent"><span class="rz-badge__dot" aria-hidden="true"></span>Held</span></header><div class="grid gap-3 px-4 pb-4 ps-5"><dl class="m-0 grid grid-cols-[minmax(80px,max-content)_1fr] gap-x-4 gap-y-1.5 rounded-[7px] border border-border bg-background/50 px-3 py-2.5 text-[13px]"><div class="contents"><dt class="text-subtle-foreground">שורה</dt><dd dir="auto" class="m-0 min-w-0 break-words text-foreground">תשלום 7 לקבלן — שלב שלד</dd></div><div class="contents"><dt class="text-subtle-foreground">סכום</dt><dd dir="auto" class="m-0 min-w-0 break-words text-foreground">120,000 €</dd></div></dl></div></article>"`;

exports[`RTL rendering > chat messages: content and trail follow their own direction 1`] = `"<div class="flex gap-3 max-w-3xl rz-enter-scale ms-auto flex-row-reverse"><span class="rz-avatar mt-0.5" aria-hidden="true">You</span><div class="min-w-0 rounded-[10px] px-4 py-3 text-[15px] leading-relaxed text-foreground bg-surface-700 rounded-se-[3px]"><div class="whitespace-pre-wrap" dir="auto"><span>כמה נשאר בתקציב של מגדל B?</span></div></div></div><div class="flex gap-3 max-w-3xl rz-enter-scale"><span class="rz-avatar rz-avatar--agent mt-0.5" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot h-3.5 w-3.5" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></span><div class="min-w-0 rounded-[10px] px-4 py-3 text-[15px] leading-relaxed text-foreground border border-border bg-card rounded-ss-[3px]"><div class="mb-1 text-xs font-medium text-violet-400">finance</div><div class="whitespace-pre-wrap" dir="auto"><span>נשארו 900 אלף אירו בתקציב של מגדל B <button type="button" class="rz-source" aria-label="Source S1">S1</button>, לפי גיליון התשלומים.</span></div><div class="mt-3 border-t border-border pt-3 text-xs text-muted-foreground"><div class="mb-1.5 text-xs font-medium text-subtle-foreground">What I used</div><ol class="m-0 grid list-none gap-1 p-0"><li id="trail-m-7-S1" class="flex min-w-0 items-center gap-2 scroll-mt-4 rounded-[5px] target:bg-blue-400/10"><span class="rz-source m-0" aria-hidden="true">S1</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg><bdi class="text-foreground">תקציב מגדל B</bdi><bdi class="min-w-0 truncate text-subtle-foreground" title="systems/tower-b/B-brain/budget.md">systems/tower-b/B-brain/budget.md</bdi></li></ol><ol class="rz-trail m-0 list-none p-0 mt-2"><li class="rz-trail__step py-1" data-state="done"><div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-0.5"><bdi class="font-mono text-foreground">sheets_read</bdi><span class="">done</span><bdi class="tabular text-subtle-foreground">412 ms</bdi></div></li><li class="rz-trail__step py-1" data-state="held"><div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-0.5"><bdi class="font-mono text-foreground">sheets_append</bdi><button type="button" class="font-medium text-brand-400 hover:underline">waiting for approval</button></div></li></ol></div></div></div>"`;

