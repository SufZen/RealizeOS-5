exports[`RTL rendering > approval cards: Hebrew parameters keep their direction 1`] = `"<article class="rz-panel relative overflow-hidden rz-held" aria-label="sheets_append: Held"><header class="flex items-start gap-3 px-4 pt-3.5 pb-3 ps-5"><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h3 class="m-0 text-[15px] font-semibold text-foreground">sheets_append</h3></div><div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-subtle-foreground"><span class="inline-flex items-center gap-1.5"><span class="rz-avatar rz-avatar--agent rz-avatar--sm" aria-hidden="true">SI</span>Agent: site-payments</span><span>Venture: tower-b</span></div></div><span class="rz-badge rz-badge--accent"><span class="rz-badge__dot" aria-hidden="true"></span>Held</span></header><div class="grid gap-3 px-4 pb-4 ps-5"><dl class="m-0 grid grid-cols-[minmax(80px,max-content)_1fr] gap-x-4 gap-y-1.5 rounded-[7px] border border-border bg-background/50 px-3 py-2.5 text-[13px]"><div class="contents"><dt class="text-subtle-foreground">שורה</dt><dd dir="auto" class="m-0 min-w-0 break-words text-foreground">תשלום 7 לקבלן — שלב שלד</dd></div><div class="contents"><dt class="text-subtle-foreground">סכום</dt><dd dir="auto" class="m-0 min-w-0 break-words text-foreground">120,000 €</dd></div></dl></div></article>"`;

