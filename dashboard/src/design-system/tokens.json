{
  "$schema": "https://schemas.amazon.com/style-dictionary/3.0/tokens.json",
  "name": "@realizeos/design-system",
  "version": "1.0.0",
  "color": {
    "bg":            { "dark": "#0a0a0f", "light": "#ffffff" },
    "bg-sunken":     { "dark": "#12121a", "light": "#f5f5f7" },
    "bg-raised":     { "dark": "#1a1a24", "light": "#ffffff" },
    "surface":       { "dark": "#2a2a36", "light": "#f4f4f5" },
    "surface-hover": { "dark": "#22222e", "light": "#ebebed" },

    "border":        { "dark": "rgba(255, 255, 255, 0.08)", "light": "#e5e5e8" },
    "border-strong": { "dark": "rgba(255, 255, 255, 0.15)", "light": "#d4d4d8" },
    "border-accent": { "dark": "rgba(255, 204, 0, 0.25)",   "light": "rgba(204, 153, 0, 0.35)" },

    "fg":            { "dark": "#e8e8ed", "light": "#0a0a0f" },
    "fg-muted":      { "dark": "#9a9ab0", "light": "#6b6b80" },
    "fg-subtle":     { "dark": "#6b6b80", "light": "#8a8a9c" },
    "fg-faint":      { "dark": "#4a4a5e", "light": "#b8b8c4" },

    "accent":        { "dark": "#ffcc00", "light": "#cc9900" },
    "accent-strong": { "dark": "#ffd633", "light": "#b38600" },
    "accent-soft":   { "dark": "rgba(255, 204, 0, 0.10)", "light": "rgba(255, 204, 0, 0.14)" },
    "accent-fg":     { "dark": "#0a0a0f", "light": "#ffffff" },
    "accent-ring":   { "dark": "rgba(255, 204, 0, 0.35)", "light": "rgba(204, 153, 0, 0.35)" },

    "success":       { "dark": "#4ade80", "light": "#16a34a" },
    "success-soft":  { "dark": "rgba(74, 222, 128, 0.12)", "light": "rgba(74, 222, 128, 0.14)" },
    "warning":       { "dark": "#fbbf24", "light": "#d97706" },
    "warning-soft":  { "dark": "rgba(251, 191, 36, 0.12)", "light": "rgba(251, 191, 36, 0.14)" },
    "danger":        { "dark": "#f87171", "light": "#dc2626" },
    "danger-soft":   { "dark": "rgba(248, 113, 113, 0.12)", "light": "rgba(248, 113, 113, 0.12)" },
    "info":          { "dark": "#93c5fd", "light": "#2563eb" },
    "info-soft":     { "dark": "rgba(147, 197, 253, 0.12)", "light": "rgba(147, 197, 253, 0.16)" }
  },

  "text": {
    "2xs":  "0.6875rem",
    "xs":   "0.75rem",
    "sm":   "0.875rem",
    "base": "0.9375rem",
    "md":   "1rem",
    "lg":   "1.125rem",
    "xl":   "1.25rem",
    "2xl":  "1.5rem",
    "3xl":  "1.875rem",
    "4xl":  "2.25rem",
    "5xl":  "3rem",
    "6xl":  "3.75rem"
  },

  "font": {
    "sans":    "\"Poppins\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "display": "\"Poppins\", -apple-system, sans-serif",
    "mono":    "\"JetBrains Mono\", \"Fira Code\", ui-monospace, Consolas, monospace",
    "rtl":     "\"Rubik\", \"Poppins\", sans-serif"
  },

  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },

  "radius": {
    "xs":   "0.25rem",
    "sm":   "0.5rem",
    "md":   "0.625rem",
    "lg":   "0.75rem",
    "xl":   "1rem",
    "full": "999px"
  },

  "shadow": {
    "1": {
      "dark":  "0 1px 2px rgba(0, 0, 0, 0.25)",
      "light": "0 1px 2px rgba(10, 10, 15, 0.06)"
    },
    "2": {
      "dark":  "0 4px 15px rgba(0, 0, 0, 0.35)",
      "light": "0 4px 15px rgba(204, 163, 0, 0.15)"
    },
    "3": {
      "dark":  "0 12px 40px rgba(0, 0, 0, 0.45)",
      "light": "0 12px 32px rgba(10, 10, 15, 0.10)"
    },
    "glow": {
      "dark":  "0 0 20px rgba(255, 204, 0, 0.20), 0 0 60px rgba(255, 204, 0, 0.05)",
      "light": "0 4px 15px rgba(204, 163, 0, 0.15)"
    }
  },

  "motion": {
    "ease-out":    "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "dur-fast":    "120ms",
    "dur":         "180ms",
    "dur-slow":    "320ms"
  }
}
