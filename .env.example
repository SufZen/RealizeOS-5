# ============================================================
# RealizeOS V5 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# Only the keys you use need values — the system auto-discovers providers.

# === LLM Providers ===
# At least one provider is required for the system to function.

# Anthropic (Claude models — recommended for content creation)
ANTHROPIC_API_KEY=
# Optional model overrides. Leave empty for the newest models (claude-sonnet-5-5 / claude-opus-5-5);
# set an older ID (e.g. claude-sonnet-4-6) only if you want that model.
# An ID Anthropic no longer serves returns 404; Settings > LLM Routing then flags it.
# CLAUDE_SONNET_MODEL=
# CLAUDE_OPUS_MODEL=

# Google AI (Gemini models — recommended for fast/simple tasks)
GOOGLE_AI_API_KEY=

# OpenAI (GPT models)
OPENAI_API_KEY=

# Ollama (local models — no API key needed, just the base URL)
OLLAMA_BASE_URL=http://localhost:11434


# === API Security ===
REALIZE_ENV=development        # development | production

# Host port for the API (used by docker-compose and the uvicorn launcher).
REALIZE_PORT=8080

# Set this to require API key authentication for programmatic callers
# (CLI, Telegram bot, external integrations). Leave empty for local-only,
# no-auth dev mode.
REALIZE_API_KEY=

# JWT Authentication (for multi-user / production setups).
# REALIZE_JWT_SECRET must be at least 32 characters for production.
REALIZE_JWT_ENABLED=false
REALIZE_JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate limits. API requests are counted per signed-in user (else per client IP);
# LLM calls are counted separately.
# API_RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_PER_MINUTE=30
# MCP tool calls per minute, per caller (each agent token and stdio session has
# its own count, apart from its person). Unset = API_RATE_LIMIT_PER_MINUTE.
# MCP_RATE_LIMIT_PER_MINUTE=120
# Reverse proxies whose X-Forwarded-For is trusted (IPs or CIDRs, comma-separated),
# e.g. the Traefik network. Leave empty when RealizeOS is reached directly.
# REALIZE_TRUSTED_PROXIES=

# Dashboard users (v5.2.0+). Two options:
#   1. users.yaml in repo root (preferred — multiple users, roles)
#   2. Single owner via env (fallback when users.yaml is absent):
# REALIZE_ADMIN_USER=owner@example.com
# REALIZE_ADMIN_PASSWORD_HASH=$2b$12$REPLACE_ME    # python scripts/hash_password.py

# ── Production Security (ALL required when REALIZE_ENV=production) ──
# Uncomment and set every line below before switching to production.
# Generate JWT secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# REALIZE_ENV=production
# REALIZE_API_KEY=<32+ random chars>
# REALIZE_JWT_ENABLED=true
# REALIZE_JWT_SECRET=<32+ random chars>
# CORS_ORIGINS=https://yourdomain.com         # comma-separated, no wildcards
#
# See docs/PRODUCTION.md for the full migration checklist.


# === Built-in MCP server (5.1.0+) ===
# When enabled, exposes RealizeOS to any MCP-speaking agent (Claude
# Desktop, Cursor, n8n, cloud routines) over HTTP+SSE at /mcp/sse.
# Reuses the same JWT / API-key auth as the REST API. Off by default.

MCP_ENABLED=false              # master switch
MCP_EXPOSE_KB=true             # kb_search, venture_kb_search, list_ventures
MCP_EXPOSE_OPS=true            # workflows, skills, evolution, approvals
MCP_ALLOW_ADMIN=false          # create/delete venture, update settings, reload agents
                               # In production this also requires REALIZE_JWT_ENABLED=true.
MCP_AUDIT_FULL_PAYLOAD=false   # log full tool args / results (PII risk, off by default)
MCP_BEARER_TOKEN_OVERRIDE=     # optional: hard-coded token for clients that can't JWT (rotate often)
MCP_TOOLS=                     # optional: serve only these tools (comma-separated); empty = all


# === Profession and market packs ===
# Optional writable folder for your own packs, or a modified copy of a shipped pack
# (<folder>/market/<id>/, <folder>/profession/<id>/). Packs here win over the shipped
# packs in packs/, which are read-only in the production image. In Docker, mount a
# volume there (see docs/self-hosting-guide.md). Approved verification levels are kept
# in DATA_PATH/packs/verification.json, not here.
# REALIZE_PACKS_PATH=


# === Channels ===

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API (optional)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# Twilio Telephony (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Web Search — Brave API (optional, enables web_search tool)
BRAVE_API_KEY=

# === Cloud Storage (S3-compatible) ===
# Configure to sync FABRIC data across devices or for cloud backup.
# Works with AWS S3, MinIO, DigitalOcean Spaces, Backblaze B2, Cloudflare R2.
# Leave empty to use local storage only (default).

S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
# Examples:
#   AWS S3:           (leave S3_ENDPOINT_URL empty)
#   MinIO:            http://localhost:9000
#   DO Spaces:        https://nyc3.digitaloceanspaces.com
#   Backblaze B2:     https://s3.us-west-004.backblazeb2.com
#   Cloudflare R2:    https://<account_id>.r2.cloudflarestorage.com


# === Database ===
# SQLite is used by default. No configuration needed for local use.
# DATABASE_URL=sqlite:///realizeos.db


# === Server ===
REALIZE_HOST=0.0.0.0
REALIZE_PORT=8080
# DEBUG=false
