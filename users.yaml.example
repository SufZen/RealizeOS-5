# RealizeOS dashboard users (v5.2.0+)
#
# Copy this file to `users.yaml` and add your real users. The path is relative
# to the working directory where you run the API (typically the repo root).
#
# `users.yaml` is gitignored by default — do not commit real password hashes.
#
# To generate a bcrypt hash for a password:
#   python scripts/hash_password.py
#
# Roles (RBAC, enforced on every write since 5.7.0):
#   owner    — everything
#   admin    — everything except security settings and user management
#   operator — work in ventures: chat, edit venture files, approve held actions
#   user     — chat and edit venture files; cannot approve
#   viewer   — read-only (cannot chat)
#
# Ventures (optional): `ventures: [key, ...]` limits a user to those ventures.
# They see only those ventures everywhere (dashboard, API, MCP) and cannot
# change anything shared by every venture (settings, integrations, ...).
# Leave it out for access to every venture.
#
# If `users.yaml` is absent, the API falls back to the single-owner env vars:
#   REALIZE_ADMIN_USER=owner@example.com
#   REALIZE_ADMIN_PASSWORD_HASH=$2b$12$...

users:
  - email: owner@example.com
    role: owner
    password_hash: $2b$12$REPLACE_ME_with_output_of_scripts_hash_password_py

  # - email: teammate@example.com
  #   role: admin
  #   password_hash: $2b$12$...

  # - email: stakeholder@example.com
  #   role: viewer
  #   password_hash: $2b$12$...

  # - email: project-manager@client.example
  #   role: operator
  #   ventures: [tower-b]
  #   password_hash: $2b$12$...
