{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realizeos.ai/schemas/v0.1/milestone.json",
  "title": "Milestone",
  "description": "A dated point that money and work depend on. Core language family (spec 010).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mil-\\d{4}-\\d{2}-[a-z0-9-]+(-\\d+)?$"
    },
    "type": {
      "type": "string",
      "const": "milestone"
    },
    "kind": {
      "type": "string",
      "description": "Specialisation within the family. Open string; packs may add kinds.",
      "examples": [
        "construction_stage",
        "design_stage",
        "permit",
        "handover"
      ]
    },
    "project": {
      "type": "string",
      "description": "Project id this object belongs to."
    },
    "venture": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "due": {
      "type": "string",
      "format": "date"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "percent_of_contract": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reached",
        "certified",
        "missed"
      ]
    },
    "sources": {
      "type": "array",
      "description": "Where the facts came from: source ids with a locator (page, cell, timestamp, message id).",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "type",
    "name"
  ],
  "additionalProperties": true,
  "x-core-family": true,
  "x-indexing": {
    "l1": [
      "id",
      "name",
      "due",
      "status"
    ],
    "l2": "Name + criteria",
    "graph_relations": [
      "sources (-> source)"
    ],
    "dreaming_relevance": "None in v0.1"
  }
}
