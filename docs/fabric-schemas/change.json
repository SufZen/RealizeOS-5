{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realizeos.ai/schemas/v0.1/change.json",
  "title": "Change",
  "description": "A request that alters scope, cost or time. Core language family (spec 010).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^chg-\\d{4}-\\d{2}-[a-z0-9-]+(-\\d+)?$"
    },
    "type": {
      "type": "string",
      "const": "change"
    },
    "kind": {
      "type": "string",
      "description": "Specialisation within the family. Open string; packs may add kinds.",
      "examples": [
        "client_change",
        "variation",
        "design_revision"
      ]
    },
    "project": {
      "type": "string",
      "description": "Project id this object belongs to."
    },
    "venture": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "scope_delta": {
      "type": "string"
    },
    "cost_delta": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "time_delta_days": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "priced",
        "approved",
        "rejected",
        "done"
      ]
    },
    "decision": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "description": "Where the facts came from: source ids with a locator (page, cell, timestamp, message id).",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "type",
    "title"
  ],
  "additionalProperties": true,
  "x-core-family": true,
  "x-indexing": {
    "l1": [
      "id",
      "title",
      "status",
      "cost_delta",
      "time_delta_days"
    ],
    "l2": "Title + scope_delta",
    "graph_relations": [
      "requested_by (-> contact)",
      "decision (-> decision)",
      "sources (-> source)"
    ],
    "dreaming_relevance": "None in v0.1"
  }
}
